{
  "manifest_version": 3,
  "name": "Auto Logbook IPB",
  "short_name": "Auto Logbook",
  "version": "0.1.0",
  "description": "Isi Log Aktivitas Kampus Merdeka di Student Portal IPB sekaligus dari Google Sheets atau Excel. Ekstensi tidak resmi.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["https://studentportal.ipb.ac.id/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Auto Logbook IPB",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://studentportal.ipb.ac.id/*"],
      "js": [
        "src/ns.js",
        "src/dates.js",
        "src/mapping.js",
        "src/tabular.js",
        "src/xlsx.js",
        "src/store.js",
        "src/portal.js",
        "src/styles.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
